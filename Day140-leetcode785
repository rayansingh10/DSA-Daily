https://leetcode.com/problems/is-graph-bipartite/description/

//bfs approach

class Solution {
public:
    bool bfs(int src,vector<int> &vis,vector<int> &set,vector<vector<int>>& adj){
        //1st node ,2nd set a or b
        queue<int> q;
        q.push(src);
        vis[src]=1;
        set[src]=0;
        while(!q.empty()){
            auto node=q.front();
            q.pop();
            for(auto ngbr : adj[node]){
                if(vis[ngbr]==0){
                    //grp-1 for alternative 0 and 1
                    q.push(ngbr);
                    set[ngbr]=abs(set[node]-1);
                    vis[ngbr]=1;
                }
                else if (vis[ngbr]==1 && set[ngbr]==set[node]) return false;
            }
        } 
        return true;       
    }
    bool isBipartite(vector<vector<int>>& graph) {
        int V=graph.size();
        vector<int> vis(V,0);
        vector<int> set(V,-1);
        for(int i=0;i<V;i++){
            if(vis[i]==0 && !bfs(i,vis,set,graph)) return false;
        }
        return true;
    }
};
