https://leetcode.com/problems/find-eventual-safe-states/

class Solution {
public:
    bool checkCyclicDirectedGraphUsingDfs(int src, unordered_map<int,bool>& visited,
unordered_map<int,bool> &dfsVisited,vector<int> &safe,unordered_map<int,vector<int>> &adjList) {

		visited[src] = true;
		dfsVisited[src] = true;
        safe[src]=0;
		for(auto nbr: adjList[src]) {
			if(!visited[nbr]) {
				bool aageKaAnswer = checkCyclicDirectedGraphUsingDfs(nbr, visited, dfsVisited,safe,adjList);
				if(aageKaAnswer == true)
					return true;
			}
			if( dfsVisited[nbr] == true) {
				return true;
			}
		}
		//yaha hi galti hoti h 
		dfsVisited[src] = false;
        safe[src]=1;
		return false;
	}
    vector<int> eventualSafeNodes(vector<vector<int>>& graph) {
        unordered_map<int,bool> visited;
        unordered_map<int,bool> dfsVisited;
        unordered_map<int,vector<int>> adjList;
        vector<int> ans;
        for(int i=0;i<graph.size();i++){
            for(auto j : graph[i]){
                adjList[i].push_back(j);
            }
        }
        vector<int> safe(graph.size(),0);
        for(int i=0;i<graph.size();i++){
            if(!visited[i]){
                checkCyclicDirectedGraphUsingDfs(i,visited,dfsVisited,safe,adjList);
            }
        }
        for(int i=0;i<graph.size();i++){
            if(safe[i]==1) ans.push_back(i);
        }
        return ans;
    }
};
